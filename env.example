# Copiar a .env y completar con los datos reales.
# El .env NUNCA se sube al repositorio ni se hornea en la imagen.
#
# Formato obligatorio: postgresql+asyncpg://usuario:clave@host:puerto/base
# (el driver postgresql+asyncpg es el que usa la aplicación).
DATABASE_URL=postgresql+asyncpg://usuario:clave@host:5432/libreria

# Diagnóstico: true escribe cada consulta SQL en la consola.
# En producción va en false.
SQL_ECHO=false
