# Copiar a .env y completar. El .env NUNCA se sube al repo.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=libreria

# Opcional: si se define, pisa los valores de arriba
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/libreria

DB_ECHO=false
